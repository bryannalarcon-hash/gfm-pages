# Copy to .env and fill. NEVER commit real secrets.
# Database — embedded PGlite by default (no Docker / external DB required for clone-and-run).
# To use node `pg` instead: set USE_PGLITE=false and a real DATABASE_URL (see docker-compose.yml).
USE_PGLITE=true
# DATABASE_URL=postgres://gfm:gfm@localhost:5432/gfm

# Demo gating — the ONLY NEXT_PUBLIC_* var that controls demo affordances.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostHog (EU cloud or self-host). Client key is publishable; personal API key is server-only.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Batch-only (never on the request path).
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Optional email mockup "send sample digest".
RESEND_API_KEY=
